# Makefile.in for StyxWire (the continuation of hping3).
#
# ./configure prepends the configuration variables (CC, CFLAGS, PCAP_LIBS,
# USE_TCL, prefix, sbindir, mandir, ...) to this file and writes Makefile.
# Everything below only refers to those variables.
#
# Useful invocations:
#   make                      build styxwire
#   make check                build and run the offline test-suite (no root)
#   make check SANITIZE=1     same, with ASan/UBSan (run "make clean" first)
#   make WERROR=1             treat warnings as errors
#   make install DESTDIR=/tmp/stage   staged installation
#   make fuzz                 build the libFuzzer targets (clang only)
#
# Copyright (C) 1999 by Salvatore Sanfilippo, GPL version 2.

# Optional knobs
SANITIZE_FLAGS_1 = -fsanitize=address,undefined -fno-omit-frame-pointer -O1
SANITIZE_FLAGS_ =
SANITIZE_FLAGS = $(SANITIZE_FLAGS_$(SANITIZE))
WERROR_FLAGS_1 = -Werror
WERROR_FLAGS_ =
WERROR_FLAGS = $(WERROR_FLAGS_$(WERROR))

ALL_CPPFLAGS = $(CPPFLAGS) $(DEFS) $(PCAP_CFLAGS) $(TCL_INC) $(USE_TCL)
ALL_CFLAGS = $(CFLAGS) $(WERROR_FLAGS) $(SANITIZE_FLAGS)
ALL_LDFLAGS = $(LDFLAGS) $(SANITIZE_FLAGS)
ALL_LDLIBS = $(PCAP_LIBS) $(SOLARISLIB) $(TCL_LIB) $(LDLIBS)

INSTALL = install

ARSOBJ = ars.o apd.o split.o rapd.o

OBJ=	main.o globals.o getifname.o getlhs.o \
	parseoptions.o datafiller.o \
	datahandler.o gethostname.o \
	binding.o clock.o opensockraw.o \
	logicmp.o waitpacket.o resolve.o \
	sendip.o sendicmp.o sendudp.o \
	sendtcp.o cksum.o statistics.o \
	usage.o version.o antigetopt.o \
	sockopt.o listen.o \
	sendhcmp.o memstr.o rtt.o \
	relid.o sendip_handler.o \
	libpcap_stuff.o memlockall.o memunlockall.o \
	memlock.o memunlock.o ip_opt_build.o \
	display_ipopt.o sendrawip.o send.o \
	strlcpy.o arsglue.o random.o scan.o lifecycle.o \
	hstring.o script.o interface.o \
	adbuf.o hex.o apdutils.o sbignum.o output.o \
	sbignum-tables.o $(ARSOBJ)

PROG = styxwire

all: $(PROG)

$(PROG): byteorder.h systype.h $(OBJ)
	$(CC) $(ALL_CFLAGS) $(ALL_LDFLAGS) -o $(PROG) $(OBJ) $(ALL_LDLIBS)
	@echo
	@echo "$(PROG) built. Try \`make check', \`make strip', \`make install'"

$(PROG)-static: byteorder.h systype.h $(OBJ)
	$(CC) -static $(ALL_CFLAGS) $(ALL_LDFLAGS) -o $(PROG)-static $(OBJ) $(ALL_LDLIBS) -ldl

libars.a: $(ARSOBJ) adbuf.o hex.o hstring.o strlcpy.o
	$(AR) rc $@ $(ARSOBJ) adbuf.o hex.o hstring.o strlcpy.o
	$(RANLIB) $@

byteorder.h systype.h:
	@echo "$@ is missing: run ./configure first" >&2; exit 1

.c.o:
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -c $<

dep: .depend
.depend:
	@echo Making dependences
	@$(CC) $(ALL_CPPFLAGS) -MM *.c > .depend

# ---------------------------------------------------------------------------
# tests (offline: no root, no network traffic, no capture devices)
# ---------------------------------------------------------------------------
# Every test binary links the real hping objects, except:
#  - main.o (the tests have their own main(); the state objects are in
#    globals.o)
#  - sendip_handler.o is replaced by tests/stub_send.o (captures packets
#    instead of writing them to a raw socket)
#  - the object of the source a test #includes to reach static functions
TEST_COMMON_OBJ = $(filter-out main.o sendip_handler.o waitpacket.o scan.o script.o,$(OBJ))
TEST_LINK = tests/stub_send.o $(TEST_COMMON_OBJ)
TEST_BINS = tests/test_core tests/test_waitpacket tests/test_scan tests/test_loop tests/test_parse tests/test_output
TEST_BINS_TCL_-DUSE_TCL = tests/test_script
TEST_BINS_TCL_ =
TEST_BINS_TCL = $(TEST_BINS_TCL_$(USE_TCL))
TEST_CC = $(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(ALL_LDFLAGS) -I.

tests/stub_send.o: tests/stub_send.c tests/stub_send.h hping2.h globals.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -I. -c -o $@ tests/stub_send.c

tests/test_core: tests/test_core.c tests/testutil.h $(TEST_LINK) waitpacket.o scan.o script.o
	$(TEST_CC) -o $@ tests/test_core.c $(TEST_LINK) waitpacket.o scan.o script.o $(ALL_LDLIBS)

tests/test_loop: tests/test_loop.c tests/testutil.h tests/stub_send.h $(TEST_LINK) waitpacket.o scan.o script.o
	$(TEST_CC) -o $@ tests/test_loop.c $(TEST_LINK) waitpacket.o scan.o script.o $(ALL_LDLIBS)

tests/test_parse: tests/test_parse.c tests/testutil.h $(TEST_LINK) waitpacket.o scan.o script.o
	$(TEST_CC) -o $@ tests/test_parse.c $(TEST_LINK) waitpacket.o scan.o script.o $(ALL_LDLIBS)

tests/test_output: tests/test_output.c tests/testutil.h $(TEST_LINK) waitpacket.o scan.o script.o
	$(TEST_CC) -o $@ tests/test_output.c $(TEST_LINK) waitpacket.o scan.o script.o $(ALL_LDLIBS)

tests/test_waitpacket: tests/test_waitpacket.c tests/testutil.h waitpacket.c $(TEST_LINK) scan.o script.o
	$(TEST_CC) -o $@ tests/test_waitpacket.c $(TEST_LINK) scan.o script.o $(ALL_LDLIBS)

tests/test_scan: tests/test_scan.c tests/testutil.h scan.c $(TEST_LINK) waitpacket.o script.o
	$(TEST_CC) -o $@ tests/test_scan.c $(TEST_LINK) waitpacket.o script.o $(ALL_LDLIBS)

tests/test_script: tests/test_script.c tests/testutil.h script.c $(TEST_LINK) waitpacket.o scan.o
	$(TEST_CC) -o $@ tests/test_script.c $(TEST_LINK) waitpacket.o scan.o $(ALL_LDLIBS)

# links against the archive only: no hping object (tests/libars.sh)
tests/libars_link: tests/libars_link.c libars.a
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(ALL_LDFLAGS) -I. -o $@ tests/libars_link.c libars.a

check: $(PROG) $(TEST_BINS) $(TEST_BINS_TCL) tests/bench
	@sh tests/run.sh $(TEST_BINS) $(TEST_BINS_TCL)

# ---------------------------------------------------------------------------
# live send/receive verification (opt-in, NOT part of "make check").
# This is the one test that opens a raw socket and puts real packets on an
# interface, so it is kept out of the default suite -- "make check" must run
# without root and without network traffic. It needs no real root and no
# physical NIC either: on Linux with unprivileged user namespaces it gets
# uid 0 inside a private, isolated network namespace, sends over a veth pair
# and nothing leaves the host. Where that is unavailable it skips (77).
# ---------------------------------------------------------------------------
check-live: $(PROG)
	@sh tests/netns.sh; rc=$$?; \
	if [ $$rc -eq 77 ]; then \
		echo "make: check-live skipped (see the SKIP line above)"; \
		exit 0; \
	fi; \
	exit $$rc

# ---------------------------------------------------------------------------
# benchmarking (offline, no root, no traffic).
#   make bench                     build and run with the defaults
#   make bench BENCHFLAGS="-n 50000 -r 9"
#   make bench BENCH_WRAP=         if your linker has no --wrap
# The numbers only mean something next to numbers taken the same way on the
# same machine: tests/bench prints the machine, the compiler and the flags
# with every run. "make check" runs tests/bench --selftest, which verifies
# the workloads compute what they claim without timing anything.
# ---------------------------------------------------------------------------
BENCH_OBJ = $(ARSOBJ) adbuf.o hex.o hstring.o strlcpy.o apdutils.o \
	sbignum.o sbignum-tables.o
BENCH_WRAP = -DBENCH_WRAP_MALLOC \
	-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=free
BENCHFLAGS =

tests/bench: tests/bench.c $(BENCH_OBJ)
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) $(ALL_LDFLAGS) -I. \
		-DBENCH_CC='"$(CC)"' -DBENCH_CFLAGS='"$(ALL_CFLAGS)"' \
		$(BENCH_WRAP) -o $@ tests/bench.c $(BENCH_OBJ) $(ALL_LDLIBS)

bench: tests/bench
	@if command -v taskset >/dev/null 2>&1; then \
		taskset -c 0 ./tests/bench $(BENCHFLAGS); \
	else ./tests/bench $(BENCHFLAGS); fi

# ---------------------------------------------------------------------------
# fuzzing (libFuzzer, clang only). The ARS engine and the option parser are
# linked into standalone fuzz drivers; the same objects as the build, minus
# main.o and the send path (a fuzz run must not touch the network).
#   make fuzz CC=clang
#   tests/fuzz_split -max_len=2048 -runs=1000000 corpus/
# CI runs a short, time-boxed session; a fixed run finding nothing is not a
# proof of absence.
# ---------------------------------------------------------------------------
FUZZ_FLAGS = -fsanitize=fuzzer,address,undefined -g -O1
# the ARS engine and its helpers are self-contained (this is libars.a plus
# sbignum and apdutils)
FUZZ_ARS_OBJ = $(ARSOBJ) adbuf.o hex.o hstring.o strlcpy.o apdutils.o 	sbignum.o sbignum-tables.o
# the whole app minus main.o, with the send path replaced by the stub so a
# run cannot touch the network
FUZZ_APP_OBJ = $(filter-out main.o sendip_handler.o,$(OBJ)) tests/stub_send.o
FUZZ_BINS = tests/fuzz_split tests/fuzz_apd tests/fuzz_opts

fuzz: $(FUZZ_BINS)

tests/fuzz_split: tests/fuzz/fuzz_split.c $(FUZZ_ARS_OBJ)
	$(CC) $(ALL_CPPFLAGS) $(FUZZ_FLAGS) -I. -o $@ tests/fuzz/fuzz_split.c $(FUZZ_ARS_OBJ) $(ALL_LDLIBS)

tests/fuzz_apd: tests/fuzz/fuzz_apd.c $(FUZZ_ARS_OBJ)
	$(CC) $(ALL_CPPFLAGS) $(FUZZ_FLAGS) -I. -o $@ tests/fuzz/fuzz_apd.c $(FUZZ_ARS_OBJ) $(ALL_LDLIBS)

tests/fuzz_opts: tests/fuzz/fuzz_opts.c $(FUZZ_APP_OBJ)
	$(CC) $(ALL_CPPFLAGS) $(FUZZ_FLAGS) -I. -o $@ tests/fuzz/fuzz_opts.c $(FUZZ_APP_OBJ) $(ALL_LDLIBS)

# ---------------------------------------------------------------------------
# cleaning
# ---------------------------------------------------------------------------
clean:
	rm -rf $(PROG) $(PROG)-static hping3 *.o libars.a tests/*.o $(TEST_BINS) tests/test_script tests/test_loop tests/test_parse tests/test_output tests/libars_link tests/bench tests/fuzz_split tests/fuzz_apd

distclean: clean
	rm -rf byteorder byteorder.h systype.h Makefile .depend .configure-tmp

# ---------------------------------------------------------------------------
# installation (honours DESTDIR, prefix, sbindir, mandir, datadir)
#
# styxwire is the binary; hping3, hping2 and hping are compatibility
# symlinks so that existing scripts keep working. The Tcl library goes to
# datadir/styxwire/lib, which the binary knows as STYXWIRE_LIBDIR.
# ---------------------------------------------------------------------------
install: $(PROG)
	$(INSTALL) -d "$(DESTDIR)$(sbindir)"
	$(INSTALL) -m 755 $(PROG) "$(DESTDIR)$(sbindir)/$(PROG)"
	ln -sf $(PROG) "$(DESTDIR)$(sbindir)/hping3"
	ln -sf $(PROG) "$(DESTDIR)$(sbindir)/hping2"
	ln -sf $(PROG) "$(DESTDIR)$(sbindir)/hping"
	$(INSTALL) -d "$(DESTDIR)$(mandir)/man8"
	$(INSTALL) -m 644 docs/styxwire.8 "$(DESTDIR)$(mandir)/man8/styxwire.8"
	ln -sf styxwire.8 "$(DESTDIR)$(mandir)/man8/hping3.8"
	@if [ -n "$(USE_TCL)" ]; then \
		$(INSTALL) -d "$(DESTDIR)$(datadir)/styxwire/lib"; \
		for f in lib/*.htcl lib/*.tcl; do \
			$(INSTALL) -m 644 "$$f" "$(DESTDIR)$(datadir)/styxwire/lib/"; \
		done; \
	fi

uninstall:
	rm -f "$(DESTDIR)$(sbindir)/$(PROG)" "$(DESTDIR)$(sbindir)/hping3" "$(DESTDIR)$(sbindir)/hping2" "$(DESTDIR)$(sbindir)/hping"
	rm -f "$(DESTDIR)$(mandir)/man8/styxwire.8" "$(DESTDIR)$(mandir)/man8/hping3.8"
	rm -rf "$(DESTDIR)$(datadir)/styxwire"

strip: $(PROG)
	@ls -l ./$(PROG)
	strip $(PROG)
	@ls -l ./$(PROG)

.PHONY: all dep check check-live fuzz bench clean distclean install uninstall strip

-include .depend
